{
  "name": "friendly-snippets",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": "css",
        "path": "./snippets-custom/css/css.json"
      },
      {
        "language": "markdown",
        "path": "./snippets-custom/markdown/markdown.json"
      },
      {
        "language": "javascript",
        "path": "./snippets-custom/javascript/javascript.json"
      },
      {
        "language": [
          "javascript",
          "java",
          "c",
          "cpp"
        ],
        "path": "./snippets-custom/common/common.json"
      },
      {
        "language": "html",
        "path": "./snippets-custom/html/html.json"
      },
      {
        "language": "lua",
        "path": "./snippets-custom/lua/lua.json"
      },
      {
        "language": "java",
        "path": "./snippets-custom/java/java.json"
      },
      {
        "language": [
          "java",
          "c",
          "cpp"
        ],
        "path": "./snippets-custom/common/c-style.json"
      },
      {
        "language": "c",
        "path": "./snippets-custom/c/c.json"
      },
      {
        "language": "cpp",
        "path": "./snippets-custom/cpp/cpp.json"
      }
    ]
  }
}
