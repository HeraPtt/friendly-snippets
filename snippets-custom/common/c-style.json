{
  "declare int": {
    "prefix": "i",
    "body": ["int $1${0:;}"],
    "description": "declare int type variable"
  },
  "declare double": {
    "prefix": "d",
    "body": ["double $1${0:;}"],
    "description": "declare double type variable"
  },
  "declare bool": {
    "prefix": "b",
    "body": ["${1:bool} $2${0:;}"],
    "description": "declare boolean type variable"
  },
  "declare string": {
    "prefix": "s",
    "body": ["String $1${0:;}"],
    "description": "declare String type variable"
  },
  "declare object": {
    "prefix": "o",
    "body": ["$1 $2${0:;}"],
    "description": "declare String type variable"
  },
  "newObject": {
    "prefix": "new",
    "body": ["${1:Object} ${2:foo} = new ${1:Object}(${3:arguments});"],
    "description": "Create new Object"
  },
  "Function ...": {
    "prefix": "fun",
    "body": ["${2:void} ${1:fun}(${3:void})$0"],
    "description": "Make a function declaration/definition/pointer"
  },
  "Function definition": {
    "prefix": "func",
    "body": ["${2:void} ${1:fun}(${3:void}) {", "\t$0", "}"],
    "description": "Define a function"
  }
}
